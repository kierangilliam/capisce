doc: Adds a reply to a ticket. An agent may mark it internal, which makes it a note only agents see.
---
route POST /tickets/{id}/replies(id, body, internal=False):
    #> Check the session -> web.Server.signedIn | 401
    actor = signedIn()
    #> Read the body -> web.readJSON | 400 BadBody
    body, internal = readJSON(request)
    #> Add the reply -> tickets.Service.Reply | 404 TicketNotFound | 400 MissingText | 403 NotAllowed | 409 TicketClosed | 409 ReopenWindowPassed
    ticket = tickets.Service.Reply(actor, id, body, internal)
    return 200, ticket

