=== GET /tickets
kind: route
group: Tickets
domain: Tickets
src: web/routes.go :: mux.HandleFunc("GET /tickets",
also: web/ticket_handlers.go :: func (s *Server) listTickets(
doc: Lists the tickets the caller may see, the most pressing first. `?status=` keeps one status.
---
route GET /tickets(status=None):
    #> Check the session -> web.Server.signedIn | 401
    actor = signedIn()
    #> List what they may see -> tickets.Service.List
    return 200, tickets.Service.List(actor, status)

=== POST /tickets
kind: route
group: Tickets
domain: Tickets
src: web/routes.go :: mux.HandleFunc("POST /tickets",
also: web/ticket_handlers.go :: func (s *Server) openTicket(
doc: Opens a ticket. A customer opens their own; an agent opens one for a customer they name.
---
route POST /tickets(subject, body, topic, priority):
    # an agent also sends customer_id
    #> Check the session -> web.Server.signedIn | 401
    actor = signedIn()
    #> Read the body -> web.readJSON | 400 BadBody
    input = readJSON(request)
    #> Open the ticket -> tickets.Service.Open | 404 CustomerNotFound | 400 MissingText | 400 UnknownPriority | 403 PriorityNotAllowed
    ticket = tickets.Service.Open(actor, input)
    return 201, ticket

