=== session_actions.sign_in
kind: def
src: console/session_actions.ts :: export async function sign_in(
doc: The person submits the sign-in form. On success the console keeps the session in the browser and opens a project.
---
def sign_in(user_name, password):
    #> Ask for anything left empty | False
    if user_name is blank or password is empty:
        show_message("Enter your name and password.")
        return False
    #> Ask the API to sign in -> api_client.login | False, with why
    try:
        result = api_client.login(user_name, password)
    except ApiError:
        show_message(error_messages.message_for(error))
        return False
    #> Keep the session in the browser
    console_state.session_token = result.token
    console_state.user_name = result.user_name
    page.remember("session token", result.token)
    page.remember("user name", result.user_name)
    #> Open a project -> open_first_project
    show_message(None)
    open_first_project()
    return True

=== session_actions.restore_session
kind: def
src: console/session_actions.ts :: export async function restore_session(
doc: The console opens in a browser that signed in before. It tries the session it kept, and falls back to the sign-in form.
---
def restore_session():
    #> Look for a session kept in the browser
    token = page.recall("session token")
    if token is None:
        console_state.screen = "sign_in"
        return
    console_state.session_token = token
    console_state.user_name = page.recall("user name")
    #> Open a project -> open_first_project
    # an ended session is refused here, and the
    # person is returned to the sign-in form
    open_first_project()

=== session_actions.open_first_project
kind: def
src: console/session_actions.ts :: export async function open_first_project(
doc: Loads the person's projects and opens the one they used last in this browser, or the first by name. Someone with no projects gets a page that offers to create one.
---
def open_first_project():
    #> Load the person's projects -> api_client.project_list | stops, with why
    try:
        console_state.projects = api_client.project_list()
    except ApiError:
        handle_refusal(error)
        return
    #> Show the empty page when there are none
    if console_state.projects is empty:
        console_state.current_project = None
        console_state.screen = "no_projects"
        return
    #> Open the last project used, or the first -> project_actions.switch_project
    last_used = page.recall("last project")
    project = the project named last_used, or the first
    project_actions.switch_project(project.name)

=== session_actions.sign_out
kind: def
src: console/session_actions.ts :: export async function sign_out(
also: console/session_actions.ts :: function forget_session(
doc: The person presses "Sign out". The console signs out even when the API cannot be told; the session then ends on its own after its eight hours.
---
def sign_out():
    #> Tell the API, ignoring any failure -> api_client.logout
    try:
        api_client.logout()
    except:
        pass
    #> Forget the session and show the sign-in form
    forget the token and user name, here and in the browser
    clear the projects, instances and disks on screen
    console_state.screen = "sign_in"
    show_message(None)

=== session_actions.handle_refusal
kind: def
src: console/session_actions.ts :: export function handle_refusal(
also: console/session_actions.ts :: function forget_session(
doc: Shows why the API refused something. Every action sends its refusals here, so an ended session always returns the person to the sign-in form.
---
def handle_refusal(error):
    #> Return to the sign-in form if the session ended
    if error.status == 401:
        forget the token and user name, here and in
            the browser
        clear the projects, instances and disks on screen
        console_state.screen = "sign_in"
        show_message("Your session ended. Sign in again.")
        return
    #> Otherwise say what went wrong -> error_messages.message_for
    show_message(error_messages.message_for(error))

=== error_messages.message_for
kind: def
src: console/error_messages.ts :: export function message_for(
also: console/error_messages.ts :: const MESSAGES
doc: Turns a refusal from the API into plain words with a next step. The console never shows the API's own message.
---
def message_for(error):
    # one fixed sentence for each ApiError name, such as
    # QuotaExceeded: "This is more than the project has
    #   left. Choose a smaller size, or delete something
    #   first."
    if error has an error_code the console knows:
        return its sentence
    return "Something went wrong. Try again."

=== project_actions.name_problem
kind: def
src: console/project_actions.ts :: export function name_problem(
also: console/project_actions.ts :: const NAME_PATTERN ; console/project_actions.ts :: const MAX_NAME_LENGTH
doc: Checks a name in the form with the same rule the API applies, so the person hears about a bad name before anything is sent.
---
def name_problem(name):
    if name is empty:
        return "Enter a name."
    # the API's rule: see names.validate_name
    if name breaks the rule for names:
        return "Use lowercase letters, numbers and dashes…"
    return None

=== project_actions.switch_project
kind: def
src: console/project_actions.ts :: export async function switch_project(
doc: The person picks a project in the project menu. Other actions also call this to reload the project after they change something in it.
---
def switch_project(project_name):
    # the three requests go out together; if any one
    # is refused nothing on screen changes
    try:
        #> Load the project, its usage and the role -> api_client.project_view
        detail = api_client.project_view(project_name)
        #> Load its instances -> api_client.instance_list
        instances = api_client.instance_list(project_name)
        #> Load its disks -> api_client.disk_list
        disks = api_client.disk_list(project_name)
    except ApiError:
        handle_refusal(error)
        return False
    #> Show the project and remember it for next time
    console_state.current_project = detail
    console_state.instances = instances
    console_state.disks = disks
    console_state.screen = "project"
    page.remember("last project", project_name)
    return True

=== project_actions.submit_create_project
kind: def
src: console/project_actions.ts :: export async function submit_create_project(
doc: The person submits the new-project form. The new project opens straight away.
---
def submit_create_project(name, description):
    #> Check the name -> name_problem | False, with what to fix
    problem = name_problem(name)
    if problem is not None:
        show_message(problem)
        return False
    #> Ask the API to create it -> api_client.project_create | False, with why
    try:
        project = api_client.project_create(name, description)
    except ApiError:
        handle_refusal(error)
        return False
    add project to console_state.projects, by name
    #> Open the new project -> switch_project
    show_message(None)
    return switch_project(name)

=== project_actions.delete_project
kind: def
src: console/project_actions.ts :: export async function delete_project(
doc: The person presses "Delete project" and confirms. The console stops early when it already knows the API would refuse.
---
def delete_project(project_name):
    #> Stop early if the API would refuse | False, with why
    # only when it is the project on screen, and from
    # what was last loaded, which may be out of date
    if project_name is console_state.current_project:
        if its role != "admin":
            show_message("Only a project admin can delete…")
            return False
        if its usage has any instances or disks:
            show_message("This project still holds…")
            return False
    #> Ask the person to confirm | False when they decline
    if not page.confirm("Delete the project…?"):
        return False
    #> Ask the API to delete it -> api_client.project_delete | False, with why
    try:
        api_client.project_delete(project_name)
    except ApiError:
        handle_refusal(error)
        return False
    #> Open another project -> session_actions.open_first_project
    page.remember("last project", None)
    show_message("The project … was deleted.")
    session_actions.open_first_project()
    return True

=== project_actions.give_role
kind: def
src: console/project_actions.ts :: export async function give_role(
doc: A project admin gives someone a role on the project on screen, from its access page.
---
def give_role(user_name, role):
    if no project is on screen:
        return False
    #> Ask for a name if it is blank | False
    if user_name is blank:
        show_message("Enter the person's name.")
        return False
    #> Ask the API to save the role -> api_client.project_member_set | False, with why
    try:
        api_client.project_member_set(project, user_name, role)
    except ApiError:
        handle_refusal(error)
        return False
    show_message("<name> is now <role> on <project>.")
    return True

=== instance_actions.instance_form_problem
kind: def
src: console/instance_actions.ts :: export function instance_form_problem(
doc: Says what is wrong with the create-instance form, or nothing. It repeats the API's limits and checks the project's remaining quota as last loaded, so most refusals are caught before sending.
---
def instance_form_problem(form):
    if no project is on screen:
        return "Choose a project first."
    #> Check the name -> project_actions.name_problem
    problem = project_actions.name_problem(form.name)
    if problem is not None:
        return problem
    #> Check the sizes are whole numbers in range
    if form.ncpus is not 1 to 8:
        return "Choose 1 to 8 CPUs."
    if form.memory_gib is not 1 to 32:
        return "Choose 1 to 32 GiB of memory."
    if form.boot_disk_size_gib is not 10 to 200:
        return "Choose a boot disk of 10 to 200 GiB."
    #> Check what the project has left of its quota
    # quota minus usage, for CPUs, memory, then disk
    if form asks for more than is left of one:
        return "This project has <n> … left. Choose less."
    return None

=== instance_actions.submit_create_instance
kind: def
src: console/instance_actions.ts :: export async function submit_create_instance(
also: console/instance_actions.ts :: function report_outcome(
doc: The person submits the create-instance form. The console checks the form, asks the API, then follows the instance until it is running or failed.
---
def submit_create_instance(form):
    #> Check the form and the quota left -> instance_form_problem | None, with what to fix
    problem = instance_form_problem(form)
    if problem is not None:
        show_message(problem)
        return None
    #> Ask the API to create it -> api_client.instance_create | None, with why
    try:
        instance = api_client.instance_create(project, form)
    except ApiError:
        session_actions.handle_refusal(error)
        return None
    replace_instance(instance)
    show_message("Creating <name>…")
    #> Wait until it is running or failed -> wait_for_instance
    settled = wait_for_instance(
        instance.id,
        ["running", "failed"],
    )
    #> Reload the project, for its new usage -> project_actions.switch_project
    project_actions.switch_project(project)
    #> Tell the person how it ended
    if settled is None:    # still unknown after 30 seconds
        return None
    if settled.state == "running":
        show_message("<name> is running at <address>.")
    else:
        show_message("<name> failed. <reason> Try again"
                     " later, or choose a smaller size.")
    return settled

=== instance_actions.wait_for_instance
kind: def
src: console/instance_actions.ts :: export async function wait_for_instance(
also: console/instance_actions.ts :: const POLL_MILLISECONDS ; console/instance_actions.ts :: const MAX_POLLS
doc: Follows an instance that is changing state: asks the API for it once a second until it reaches one of the states wanted, and gives up after 30 tries.
---
def wait_for_instance(instance_id, states):
    for 30 tries:
        #> Wait a second
        page.sleep(1 second)
        #> Ask the API for the instance -> api_client.instance_view | None, with why
        try:
            instance = api_client.instance_view(instance_id)
        except ApiError:
            session_actions.handle_refusal(error)
            return None
        #> Show its state, and stop once it has settled
        replace_instance(instance)
        if instance.state in states:
            return instance
    #> Give up after 30 tries | None
    show_message("This is taking longer than usual. Reload…")
    return None

=== instance_actions.stop_instance
kind: def
src: console/instance_actions.ts :: export async function stop_instance(
also: console/instance_actions.ts :: function report_outcome(
doc: The person presses "Stop" on an instance. The console asks them to confirm, because whatever is running on the instance is interrupted.
---
def stop_instance(instance):
    #> Only a running instance can be stopped | None
    if instance.state != "running":
        show_message("Only a running instance can be…")
        return None
    #> Ask the person to confirm | None when they decline
    if not page.confirm("Stop <name>? Anything running…"):
        return None
    #> Ask the API to stop it -> api_client.instance_stop | None, with why
    try:
        stopping = api_client.instance_stop(instance.id)
        replace_instance(stopping)
    except ApiError:
        session_actions.handle_refusal(error)
        return None
    show_message("Stopping <name>…")
    #> Wait until it is stopped -> wait_for_instance
    settled = wait_for_instance(instance.id, ["stopped"])
    #> Tell the person it stopped
    if settled is not None:
        show_message("<name> is stopped.")
    return settled

=== instance_actions.start_instance
kind: def
src: console/instance_actions.ts :: export async function start_instance(
also: console/instance_actions.ts :: function report_outcome(
doc: The person presses "Start" on a stopped or failed instance. The console follows it until it is running or has failed again.
---
def start_instance(instance):
    #> Only a stopped or failed instance can start | None
    if instance.state not in ["stopped", "failed"]:
        show_message("Only a stopped instance can be…")
        return None
    #> Ask the API to start it -> api_client.instance_start | None, with why
    try:
        starting = api_client.instance_start(instance.id)
        replace_instance(starting)
    except ApiError:
        session_actions.handle_refusal(error)
        return None
    show_message("Starting <name>…")
    #> Wait until it is running or failed -> wait_for_instance
    settled = wait_for_instance(
        instance.id,
        ["running", "failed"],
    )
    #> Tell the person how it ended
    if settled is None:
        return None
    if settled.state == "running":
        show_message("<name> is running.")
    else:
        show_message("<name> failed. <reason> Try again"
                     " later, or choose a smaller size.")
    return settled

=== instance_actions.delete_instance
kind: def
src: console/instance_actions.ts :: export async function delete_instance(
doc: The person presses "Delete" on an instance and confirms. The console warns that the boot disk goes too.
---
def delete_instance(instance):
    #> Only a stopped or failed instance can go | False
    if instance.state not in ["stopped", "failed"]:
        show_message("Stop the instance first, then…")
        return False
    #> Ask the person to confirm | False when they decline
    if not page.confirm("Delete <name>? Its boot disk is"
            " deleted with it. Other disks are kept."):
        return False
    #> Ask the API to delete it -> api_client.instance_delete | False, with why
    try:
        api_client.instance_delete(instance.id)
    except ApiError:
        session_actions.handle_refusal(error)
        return False
    show_message("<name> was deleted.")
    #> Reload the project -> project_actions.switch_project
    project_actions.switch_project(the project on screen)
    return True

=== disk_actions.submit_create_disk
