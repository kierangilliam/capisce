src: console/disk_actions.ts :: export async function submit_create_disk(
doc: The person submits the new-disk form.
---
def submit_create_disk(name, size_gib):
    if no project is on screen:
        return False
    #> Check the name and the size -> project_actions.name_problem | False, with what to fix
    problem = project_actions.name_problem(name)
    if problem is not None:
        show_message(problem)
        return False
    if size_gib is not a whole number from 1 to 1000:
        show_message("Choose a size of 1 to 1000 GiB.")
        return False
    #> Ask the API to create it -> api_client.disk_create | False, with why
    try:
        api_client.disk_create(project, name, size_gib)
    except ApiError:
        session_actions.handle_refusal(error)
        return False
    show_message("The disk <name> was created.")
    #> Reload the project -> project_actions.switch_project
    return project_actions.switch_project(project)

=== disk_actions.attach_disk
kind: def
src: console/disk_actions.ts :: export async function attach_disk(
doc: The person picks a disk to attach to an instance.
---
def attach_disk(instance, disk):
    #> The instance must be stopped | False
    if instance.state != "stopped":
        show_message("Stop the instance first, then attach…")
        return False
    #> Ask the API to attach it -> api_client.instance_disk_attach | False, with why
    try:
        attached = api_client.instance_disk_attach(
            instance.id,
            disk.id,
        )
    except ApiError:
        session_actions.handle_refusal(error)
        return False
    #> Show the disk as attached
    replace the disk in console_state.disks with attached
    show_message("<disk> is attached to <instance>.")
    return True

=== disk_actions.delete_disk
kind: def
src: console/disk_actions.ts :: export async function delete_disk(
doc: The person presses "Delete" on a disk. There is no confirm step, and an attached disk is refused in the console.
---
def delete_disk(disk):
    if no project is on screen:
        return False
    #> An attached disk cannot be deleted | False
    if disk.attached_instance_id is not None:
        show_message("This disk is attached to an instance…")
        return False
    #> Ask the API to delete it -> api_client.disk_delete | False, with why
    try:
        api_client.disk_delete(disk.id)
    except ApiError:
        session_actions.handle_refusal(error)
        return False
    show_message("The disk <name> was deleted.")
    #> Reload the project -> project_actions.switch_project
    return project_actions.switch_project(project)

=== api_client.api_request
kind: def
src: console/api_client.ts :: export async function api_request<
doc: Sends one request to the API with the session token, and turns any refusal into an error that carries the API's name for it. Every other function of the API client goes through here.
---
def api_request(method, path, body=None):
    #> Add the session token, when signed in
    if console_state.session_token is not None:
        headers.Authorization = "Bearer <token>"
    #> Send the request | ApiError Unreachable
    try:
        response = fetch(API_ORIGIN + path, body as JSON)
    except:
        raise ApiError(0, "Unreachable")
    #> Read the answer | ApiError with the API's error_code
    if response.status == 204:
        return None
    if response is not ok:
        # the name is "Unknown" when the API sent none
        raise ApiError(response.status, answer.error_code)
    return the answer

