# Copy to .env and fill in. .env is ignored by git; never commit it.

# The Cloudflare account: dash.cloudflare.com, then Account ID in the right column of any zone's Overview.
CLOUDFLARE_ACCOUNT_ID=
# An API token with "Workers Scripts: Edit" and, for custom domains, "Zone: Workers Routes: Edit" and "DNS: Edit".
# Make one at dash.cloudflare.com/profile/api-tokens. Leave empty if `npx wrangler login` was run on this machine.
CLOUDFLARE_API_TOKEN=
# The Worker that serves the site.
CF_WORKER_NAME=capisce
# Custom domains, comma separated. Their zone must be on the same account.
CF_DOMAINS=capisce.software,www.capisce.software
