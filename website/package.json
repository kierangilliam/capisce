{
  "name": "capisce-website",
  "private": true,
  "type": "module",
  "scripts": {
    "pages": "node scripts/build_pages.mjs",
    "dev": "node scripts/build_pages.mjs && vite",
    "build": "node scripts/build_pages.mjs && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "diff-data": "node scripts/make_diff_data.mjs",
    "deploy": "pnpm build && node --env-file-if-exists=.env scripts/deploy.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
